---
import { discordOauthUrl as buildDiscordOauthUrl } from '../_utils/discord-oauth';
import AuthWidget from './react/graphql-provided/AuthWidget';
import { AdminAccessWatcher } from './react/AdminNavLink';

interface Props {
  authPrompt: boolean;
}

const { authPrompt } = Astro.props;
const hasuraUri = import.meta.env.HASURA_GRAPHQL_URI as string;
const discordOauthUrl = buildDiscordOauthUrl();

type Route = { path: string; display: string; adminOnly?: boolean };

const routes: Route[] = [
  { path: '/', display: 'Ladder' },
  { path: '/mechanics', display: 'Farm' },
  { path: '/order-book', display: 'Orders' },
  { path: '/filters', display: 'Filters' },
  { path: '/rules', display: 'Rules' },
  { path: '/admin', display: 'Admin', adminOnly: true },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (path: string) =>
  path === '/' ? pathname === '/' : pathname === path || pathname.startsWith(`${path}/`);
---

<header
  class="fixed inset-x-0 top-0 z-30 h-14 border-b border-primary-900/50 bg-gray-950"
>
  <!-- no backdrop-filter/transform here: it would trap the fixed-position
       mobile menu and the login modal inside the bar -->
  <div
    class="mx-auto flex h-full max-w-xl items-center gap-2 px-3 md:max-w-2xl lg:max-w-5xl xl:max-w-7xl 2xl:max-w-[90rem] sm:px-4"
  >
    <a
      href="/"
      aria-label="Smol app"
      class="mr-2 flex shrink-0 items-center no-underline opacity-90 hover:opacity-100 lg:mr-6"
    >
      <img src="/smol-logo.svg" alt="" class="h-10 w-auto" />
    </a>

    <!-- desktop tabs -->
    <nav aria-label="Main" class="hidden h-full items-stretch md:flex">
      {
        routes.map(({ path, display, adminOnly }) => (
          <a
            href={path}
            aria-current={isCurrent(path) ? 'page' : undefined}
            class:list={[
              'nav-tab relative flex items-center px-3 text-base no-underline transition-colors lg:px-4',
              isCurrent(path)
                ? 'text-primary-400'
                : 'text-primary-800 hover:text-primary-300',
              adminOnly && 'admin-only',
            ]}
          >
            {display}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <AuthWidget
        client:only="react"
        authPrompt={authPrompt}
        discordOauthUrl={discordOauthUrl}
        hasuraUri={hasuraUri}
      />

      <!-- mobile menu toggle -->
      <input type="checkbox" id="nav-toggle" class="peer sr-only" />
      <label
        for="nav-toggle"
        aria-label="Menu"
        class="flex h-9 w-9 cursor-pointer select-none items-center justify-center rounded text-2xl text-primary-500 hover:bg-gray-800 md:hidden"
      >
        <span class="nav-open">☰</span>
        <span class="nav-close hidden">✕</span>
      </label>

      <!-- mobile menu -->
      <nav
        aria-label="Main"
        class="fixed inset-x-0 top-14 hidden flex-col border-b border-primary-900/50 bg-gray-950 py-2 shadow-lg peer-checked:flex md:!hidden"
      >
        {
          routes.map(({ path, display, adminOnly }) => (
            <a
              href={path}
              aria-current={isCurrent(path) ? 'page' : undefined}
              class:list={[
                'border-l-2 px-5 py-3 text-lg no-underline',
                isCurrent(path)
                  ? 'border-primary-500 bg-gray-900 text-primary-400'
                  : 'border-transparent text-primary-800 hover:bg-gray-900 hover:text-primary-300',
                adminOnly && 'admin-only',
              ]}
            >
              {display}
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <AdminAccessWatcher client:only="react" hasuraUri={hasuraUri} />
</header>

<style>
  /* active tab marker along the header's bottom edge */
  .nav-tab[aria-current='page']::after {
    content: '';
    position: absolute;
    inset-inline: 0.75rem;
    bottom: -1px;
    height: 2px;
    border-radius: 1px;
    background: theme('colors.primary.500');
  }

  #nav-toggle:checked ~ label .nav-open {
    display: none;
  }
  #nav-toggle:checked ~ label .nav-close {
    display: inline;
  }
</style>

<style is:global>
  /* Admin shows from the first paint: the head script in Layout.astro sets
     data-admin from the stored token's roles, and AdminAccessWatcher keeps
     it in step with the live flag. */
  .admin-only {
    display: none !important;
  }
  html[data-admin] .admin-only {
    display: flex !important;
  }
</style>
