---
import { ViewTransitions } from 'astro:transitions';
import '../../base.css';
import Navigation from '../components/Navigation.astro';
interface Props {
  title: string;
  authPrompt: boolean;
}

const { title, authPrompt } = Astro.props;

// Bump to force every browser to drop its stored session and preferences
// (e.g. after changing what a login stores).
const version = 'settlers_1.0.2';
---

<!doctype html>
<html lang="en" class="bg-gray-950 h-screen">
  <head>
    <meta charset="UTF-8" />

    <meta name="og:description" content="An app for all smol league enjoyers" />
    <meta property="og:url" content="https://smol-app.netlify.app" />
    <meta property="og:title" content="Smol App" />
    <meta
      property="og:image"
      content="https://smol-app.netlify.app/poe-logo-original.png"
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/poe-logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
    <script is:inline define:vars={{ version }}>
      // Runs on every page, before any island reads localStorage. A browser
      // with no stored version is new (or predates this check): it has
      // nothing stale to clear, so it is only stamped — wiping there would
      // sign out someone who logged in without ever visiting the home page.
      {
        const stored = localStorage.getItem('version');
        if (stored !== null && stored !== version) localStorage.clear();
        if (stored !== version) localStorage.setItem('version', version);
      }
    </script>
    <script is:inline>
      // Show the Admin tab from the first paint: admins' tokens carry the
      // "dev" role. Page swaps (view transitions) replace <html>'s
      // attributes, so it is set again after each one. AdminAccessWatcher
      // then follows the live admin flag.
      {
        const markAdmin = () => {
          let admin = false;
          try {
            const token = localStorage.getItem('hasura_token');
            const payload = token?.split('.')[1];
            if (payload) {
              const claims = JSON.parse(
                atob(payload.replace(/-/g, '+').replace(/_/g, '/')),
              )['https://hasura.io/jwt/claims'];
              admin = claims?.['x-hasura-allowed-roles']?.includes('dev') ?? false;
            }
          } catch {}
          document.documentElement.toggleAttribute('data-admin', admin);
        };
        markAdmin();
        document.addEventListener('astro:after-swap', markAdmin);
      }
    </script>
  </head>
  <body class="h-screen">
    <Navigation authPrompt={authPrompt} />
    <div
      class="mx-auto h-full max-w-xl pt-14 md:max-w-2xl lg:max-w-5xl xl:max-w-7xl 2xl:max-w-[90rem]"
    >
      <slot />
    </div>
  </body>
</html>
